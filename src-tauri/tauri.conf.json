{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-task-manager",
  "version": "0.2.0",
  "identifier": "com.reddragon.task-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "cargo build --release --locked -p otm"
  },
  "app": {
    "windows": [
      {
        "title": "Open Task Manager",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A fast, open-source process and performance monitor",
    "longDescription": "Open Task Manager is a fast, open-source process and performance monitor for Windows, macOS, and Linux, built with Tauri and Rust instead of Electron.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "assets/open-task-manager.desktop.hbs",
        "section": "utils",
        "files": {
          "/usr/bin/otm": "../target/release/otm"
        },
        "conflicts": [
          "task-manager"
        ],
        "replaces": [
          "task-manager"
        ]
      },
      "rpm": {
        "desktopTemplate": "assets/open-task-manager.desktop.hbs",
        "files": {
          "/usr/bin/otm": "../target/release/otm"
        },
        "conflicts": [
          "task-manager"
        ],
        "obsoletes": [
          "task-manager"
        ]
      }
    },
    "category": "Utility"
  }
}
