{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "task-manager",
  "version": "0.2.0",
  "identifier": "com.reddragon.task-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Task Manager",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A fast, open-source process and performance monitor",
    "longDescription": "Open Task Manager is a fast, open-source process and performance monitor for Windows, macOS, and Linux, built with Tauri and Rust instead of Electron.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "assets/task-manager.desktop.hbs"
      }
    }
  }
}
